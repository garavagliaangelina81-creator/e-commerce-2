<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/css/formularioUser.css"> 
        <title>ANTOJITOS</title>
        <link rel="icon" href="/img/favicon.ico" type="image/x-icon">
    </head>

    <body>

        <main class="main-auth">

            <div class="ingreso-card"> 

                <a class="volver" href="/"><span class="flecha">&larr;</span> Volver</a>
                <h1>Iniciar sesión</h1>
                <form action="/login" method="post">
                    <label for="email">Email</label>
                    <input type="email" name="email" id="email" placeholder="Nombre" required value="<%= locals.oldData ? oldData.email : '' %>">
                    
                    <!-- en caso de haber un error, muestra el mensaje -->
                    <% if (locals.errors && errors.email) { %>
                        <p style="color: red;" class="error-msg"><%= errors.email.msg %></p>
                    <% } %>

                        <label for="password">Contraseña</label>
                        <input type="password" name="password" id="password" placeholder="*********" required>
                    <% if (locals.errors && errors.password) { %>
                        <p style="color: red;" class="error-msg"><%= errors.password.msg %></p>
                    <% } %>

                    <button type="submit">Iniciar sesión</button>    
                </form>
                <p>¿No tienes cuenta?<a href="/register"> Registrarse</a></p> 
            </div>
        </main>
    </body>
</html>