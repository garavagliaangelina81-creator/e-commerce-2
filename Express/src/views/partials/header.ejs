<header>
    <a class="logo" href="/"><img src="/img/logo.png"></a>
    
    <form id="buscar" action="/producto/buscar" method="get">
        <input type="text" name="consulta" id="buscar" placeholder="   Buscar..." required>
        <button type="submit">🔍</button>
    </form>
    
    <div id="headerBotones">    
        <a class="carritoHeader" href="/carrito">
            <img src="/img/carrito.png" alt="carrito en header">
            <span class="carrito-count"><%= carritoCantidad %></span>
        </a>
        
        <% if (usuarioLogueado) { %>
            <!-- si el usuario esta logueado se muestra el nombre y el botón de cerrar sesión -->
            <a class="login" href="/logout" title="Cerrar sesión" style="display: flex; align-items: center; text-decoration: none;">
                <span style="margin-right: 8px; font-size: 0.9rem; font-weight: bold; color: inherit;">
                    <%= usuarioLogueado.nombre %> (Salir)
                </span>
                <img class="sesion" src="/img/sesion.png" alt="Cerrar sesión">
            </a>
        <% } else { %>
            <a class="login" href="/login">
                <img class="sesion" src="/img/sesion.png" alt="sesion en header">
            </a>
        <% } %>
        
    </div>
</header>