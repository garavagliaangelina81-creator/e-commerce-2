<link rel="stylesheet" href="/css/categoria.css">
<section class="categorias-seccion">
    <div class="categorias-header">
        <h2>Categorías</h2>
        <a href="#" class="categoria-link-cat">Mostrar todas las categorías</a>
    </div>

    <div class="categorias-grid">
    <% if (typeof categoriasBarra !== 'undefined') { %>

        <% categoriasBarra.forEach(categoria => { %>
        <a href="/categoria/<%= categoria.categoria_id %>" class="categoria-tarjeta">
                    
                    <div class="cat-foto-box">
                        <img src="<%= categoria.imagen %>" alt="<%= categoria.nombre_categoria %>" onerror="this.src='/img/fallback.jpg'">
                    </div>
                    
                    <div class="cat-texto-box">
                        <span><%= categoria.nombre_categoria %></span>
                    </div>
                    
                </a>

            <% }) %>
        <% } %>
    </div>
</section>